// .vscode/tasks.json
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Export to Static Site",
            "type": "shell",
            "linux" : {
                "command": "php artisan export:export"
            },
            "osx" : {
                "command": "/opt/homebrew/bin/php artisan export:export"
            },
            "options": {
                "cwd": "${workspaceFolder}/www"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}